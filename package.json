{
  "name": "po-tool",
  "version": "0.1.0",
  "description": "Application de suivi de sprints et de gestion de vélocité",
  "main": "src/server.js",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "dev:preprod": "cross-env NODE_ENV=preprod nodemon src/server.js",
    "dev:prod": "cross-env NODE_ENV=production nodemon src/server.js",
    "start:preprod": "cross-env NODE_ENV=preprod node src/server.js",
    "start:prod": "cross-env NODE_ENV=production node src/server.js",
    "env:dev": "node scripts/set-env.js development",
    "env:preprod": "node scripts/set-env.js preprod",
    "env:prod": "node scripts/set-env.js production",
    "push": "bash scripts/push-to-github.sh"
  },
  "keywords": [
    "sprint",
    "agile",
    "velocity",
    "scrum"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "country-flag-emoji-json": "^2.0.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^6.9.0",
    "express-session": "^1.18.1",
    "helmet": "^7.0.0",
    "i18next": "^23.4.4",
    "i18next-http-middleware": "^3.3.2",
    "jsonwebtoken": "^9.0.1",
    "mongoose": "^7.5.0",
    "multer": "^1.4.5-lts.2",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "react-beautiful-dnd": "^13.1.1",
    "xlsx": "^0.18.5",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "jest": "^29.6.4",
    "mongodb-memory-server": "^8.15.1",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.3"
  }
}
