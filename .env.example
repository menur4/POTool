# ===================================
# Configuration POTool
# ===================================

# Environnement (development | production | test)
NODE_ENV=development

# ===================================
# Serveur Backend
# ===================================
PORT=3002
HOST=localhost

# ===================================
# Base de données MongoDB
# ===================================
# Local (développement)
MONGODB_URI=mongodb://localhost:27017/potool

# MongoDB Atlas (production) - décommenter et configurer si nécessaire
# MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/potool?retryWrites=true&w=majority

# ===================================
# Authentification JWT
# ===================================
JWT_SECRET=changez_cette_cle_en_production_minimum_32_caracteres
JWT_EXPIRES_IN=1d

# ===================================
# URLs Client
# ===================================
CLIENT_URL=http://localhost:3001

# ===================================
# Google OAuth (optionnel)
# ===================================
# GOOGLE_CLIENT_ID=votre_google_client_id
# GOOGLE_CLIENT_SECRET=votre_google_client_secret

# ===================================
# Configuration Email (optionnel)
# ===================================
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USER=votre_email@example.com
# EMAIL_PASSWORD=votre_mot_de_passe
# EMAIL_FROM=noreply@potool.com

# ===================================
# Intégration Jira (TLS en entreprise)
# ===================================
# Si un proxy d'entreprise intercepte le HTTPS, Node ne reconnaît pas son
# autorité racine -> erreur "unable to get local issuer certificate".
# Voie SÉCURISÉE (recommandée) : fournir le certificat racine interne.
# NODE_EXTRA_CA_CERTS=/chemin/vers/ca-entreprise.pem
# Voie DÉPANNAGE (non sécurisée, usage interne uniquement) : ignorer la vérif.
# JIRA_INSECURE_TLS=true

# ===================================
# Internationalisation
# ===================================
# Langue par défaut (fr | en | ar)
DEFAULT_LANGUAGE=fr
