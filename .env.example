# Configuration de l'environnement
NODE_ENV=development

# Configuration du serveur
PORT=3000
HOST=localhost

# Configuration de la base de données MongoDB
MONGODB_URI=mongodb://localhost:27017/potool_dev
MONGODB_URI_PREPROD=mongodb://localhost:27017/potool_preprod
MONGODB_URI_PROD=mongodb://localhost:27017/potool_prod

# Configuration JWT
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRE=30d

# Configuration de session
SESSION_SECRET=your_session_secret_key

# Configuration Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Configuration des emails (pour les notifications)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=your_email@example.com
EMAIL_PASSWORD=your_email_password
EMAIL_FROM=noreply@potool.com

# Langue par défaut
DEFAULT_LANGUAGE=fr
